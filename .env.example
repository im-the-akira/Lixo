# ============================================================
# ARQUIVO DE CONFIGURAÇÃO - API KEYS
# ------------------------------------------------------------
# LINHA ABAIXO: Substitua o valor entre aspas por sua chave real.
# NUNCA envie este arquivo com as chaves reais para alguém.
# ============================================================

# --- Anthropic (Claude) ---
# Ex: sk-ant-api03-...
ANTHROPIC_API_KEY="SUA_CHAVE_AQUI"

# --- OpenAI ---
# Ex: sk-proj-...
OPENAI_API_KEY="SUA_CHAVE_AQUI"

# --- Google (Gemini / Vertex AI) ---
# Ex: AIza...
GOOGLE_API_KEY="SUA_CHAVE_AQUI"

# --- Groq ---
# Ex: gsk_...
GROQ_API_KEY="SUA_CHAVE_AQUI"

# --- OpenRouter ---
# Ex: sk-or-v1-...
OPENROUTER_API_KEY="SUA_CHAVE_AQUI"

# --- Cerebras ---
# Ex: sk-cw-...
CEREBRAS_API_KEY="SUA_CHAVE_AQUI"

# --- Together AI ---
# Ex: t2a_...
TOGETHER_API_KEY="SUA_CHAVE_AQUI"

# ============================================================
# CONFIGURAÇÕES DE MODELO E PRONTO
# ============================================================

# Nome do modelo padrão (ex: gpt-4o, claude-sonnet-4, gemini-2.0-flash)
DEFAULT_MODEL="modelo-padrao"

# Provedor de API (anthropic, openai, google, groq, openrouter)
DEFAULT_PROVIDER="seu-provider"

# URL base da API (opcional, para endpoints customizados)
API_BASE_URL="https://api.openai.com/v1"

# ------------------------------------------------------------
# ⚠️ NÃO ALTERE NADA ACIMA SEM CONHECER O FUNCIONAMENTO
# ------------------------------------------------------------

# Para tornar todas as chaves opcionais (versão de teste), descomente:
# ANTHROPIC_API_KEY=""
# OPENAI_API_KEY=""
